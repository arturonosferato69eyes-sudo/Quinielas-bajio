<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Quinielas Bajío</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    padding: 15px;
    font-family: Arial, sans-serif;
    background: linear-gradient(135deg, #071b32, #123e52);
    color: white;
}

.contenedor {
    max-width: 520px;
    margin: auto;
}

.encabezado {
    text-align: center;
    padding: 22px 10px;
    background: linear-gradient(135deg, #087f5b, #13a66b);
    border-radius: 18px;
    margin-bottom: 15px;
}

.encabezado h1 {
    margin: 0;
    font-size: 29px;
}

.encabezado p {
    margin-bottom: 0;
}

.tarjeta {
    background: white;
    color: #172b3a;
    padding: 17px;
    border-radius: 16px;
    margin-bottom: 15px;
}

input {
    width: 100%;
    padding: 14px;
    border: 2px solid #dce5ec;
    border-radius: 10px;
    font-size: 17px;
    margin-top: 8px;
}

.precio {
    text-align: center;
    font-size: 22px;
    font-weight: bold;
    color: #087f5b;
}
